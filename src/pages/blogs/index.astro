---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { CalendarDays, Clock, ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';
import { site } from '../../data/content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const readingTime = (body: string) => Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 220));

// Per-card accent gradients, matching the Projects section
const accents = [
  'from-blush-200 to-coral-400/80',
  'from-lavender-200 to-violet-500/80',
  'from-sunny-200 to-peach-300/80',
  'from-mint-200 to-teal-400/70',
  'from-peach-200 to-coral-400/70',
  'from-blush-200 to-lavender-400/80',
];
---

<Layout
  title={`Blog — ${site.name}`}
  description="Notes on Swift, SwiftUI, architecture, and mentoring — written by Marwa Attef."
>
  <Navbar client:load pathname={Astro.url.pathname} />
  <main>
    <section class="relative overflow-hidden bg-gradient-to-b from-cream via-lavender-50 to-cream pt-32 pb-20 dark:from-plum-950 dark:via-plum-900/40 dark:to-plum-950 sm:pt-40 sm:pb-28">
      <!-- blob decoration -->
      <div aria-hidden="true" class="blob-alt absolute -right-24 top-24 h-80 w-80 bg-blush-100/70 blur-2xl dark:bg-blush-300/5" />
      <div aria-hidden="true" class="blob absolute -left-24 bottom-10 h-72 w-72 bg-sunny-200/50 blur-2xl dark:bg-sunny-300/5" />

      <div class="relative mx-auto max-w-6xl px-5 sm:px-8">
        <div class="reveal mx-auto max-w-2xl text-center">
          <span aria-hidden="true" class="mb-4 inline-grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-blush-200 via-peach-200 to-sunny-200 text-2xl shadow-soft dark:from-plum-800 dark:via-plum-800 dark:to-blush-300/30">
            ✍️
          </span>
          <p class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-coral-500 dark:text-coral-400">
            Blog
          </p>
          <h1 class="font-display text-3xl font-bold text-plum dark:text-cream sm:text-4xl">
            Notes &amp; thoughts
          </h1>
          <p class="mt-3 text-base leading-relaxed text-plum-soft dark:text-lavender-100/75 sm:text-lg">
            Ideas on Swift, SwiftUI, architecture, and mentoring — written for my future self (and you).
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            posts.map((post, i) => {
              const accent = accents[i % accents.length];
              return (
                <a
                  href={`${import.meta.env.BASE_URL}blogs/${post.id}/`}
                  class="group flex flex-col rounded-4xl border border-white/70 bg-white/80 p-6 shadow-soft backdrop-blur-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lift dark:border-plum-800 dark:bg-plum-900/60"
                >
                  <div
                    class={`mb-5 grid h-24 place-items-center rounded-3xl bg-gradient-to-br ${accent} text-4xl shadow-soft transition-transform duration-300 group-hover:scale-[1.03]`}
                  >
                    <span aria-hidden="true">{post.data.emoji}</span>
                  </div>

                  <div class="flex items-center gap-3 text-xs font-semibold text-plum-muted dark:text-lavender-100/60">
                    <span class="inline-flex items-center gap-1.5">
                      <CalendarDays size={13} aria-hidden="true" class="text-coral-400" />
                      {dateFormatter.format(post.data.pubDate)}
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <Clock size={13} aria-hidden="true" class="text-coral-400" />
                      {readingTime(post.body)} min read
                    </span>
                  </div>

                  <h2 class="mt-3 font-display text-xl font-bold leading-snug text-plum transition-colors group-hover:text-coral-500 dark:text-cream dark:group-hover:text-coral-400">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-plum-soft dark:text-lavender-100/75">
                    {post.data.description}
                  </p>

                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {
                      post.data.tags.map((tag) => (
                        <span key={tag} class="rounded-full bg-lavender-100 px-2.5 py-1 text-xs font-semibold text-violet-600 dark:bg-plum-800 dark:text-lavender-300">
                          {tag}
                        </span>
                      ))
                    }
                  </div>

                  <span class="mt-5 inline-flex items-center gap-2 self-start text-sm font-bold text-coral-500 transition-colors group-hover:text-coral-600 dark:text-coral-400 dark:group-hover:text-coral-300">
                    Read post
                    <ArrowRight size={16} aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                </a>
              );
            })
          }
        </div>

        {
          posts.length === 0 && (
            <p class="mt-14 text-center text-base text-plum-soft dark:text-lavender-100/75">
              No posts yet — check back soon! 🚧
            </p>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
