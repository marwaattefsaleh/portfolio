---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { ArrowLeft, ArrowRight, CalendarDays, Clock } from 'lucide-react';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const readingTime = Math.max(
  1,
  Math.ceil(post.body.trim().split(/\s+/).length / 220)
);

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const index = allPosts.findIndex((p) => p.id === post.id);
const nextPost = index >= 0 ? allPosts[index + 1] : undefined;
---

<Layout
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
>
  <Navbar client:load pathname={Astro.url.pathname} />
  <main class="relative overflow-hidden bg-gradient-to-b from-cream via-lavender-50 to-cream dark:from-plum-950 dark:via-plum-900/40 dark:to-plum-950">
    <!-- blob decoration -->
    <div aria-hidden="true" class="blob-alt absolute -right-24 top-24 h-80 w-80 bg-blush-100/70 blur-2xl dark:bg-blush-300/5" />
    <div aria-hidden="true" class="blob absolute -left-24 top-1/3 h-72 w-72 bg-sunny-200/50 blur-2xl dark:bg-sunny-300/5" />

    <article class="relative mx-auto max-w-3xl px-5 pt-32 pb-20 sm:px-8 sm:pt-40 sm:pb-28">
      <!-- Back to blog -->
      <a
        href={`${import.meta.env.BASE_URL}blogs/`}
        class="reveal inline-flex items-center gap-2 text-sm font-bold text-plum-soft transition-colors hover:text-coral-500 dark:text-lavender-100/80 dark:hover:text-coral-400"
      >
        <ArrowLeft size={16} aria-hidden="true" />
        All posts
      </a>

      <!-- Post hero -->
      <header class="reveal mt-8" style="--reveal-delay: 80ms">
        <span aria-hidden="true" class="mb-6 inline-grid h-20 w-20 place-items-center rounded-4xl bg-gradient-to-br from-blush-200 via-peach-200 to-sunny-200 text-4xl shadow-soft dark:from-plum-800 dark:via-plum-800 dark:to-blush-300/30">
          {post.data.emoji}
        </span>

        <p class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-coral-500 dark:text-coral-400">
          Blog
        </p>
        <h1 class="font-display text-3xl font-bold leading-tight text-plum dark:text-cream sm:text-4xl">
          {post.data.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-plum-soft dark:text-lavender-100/80">
          {post.data.description}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm font-semibold text-plum-muted dark:text-lavender-100/60">
          <span class="inline-flex items-center gap-2">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-blush-300 via-coral-400 to-sunny-300 text-sm text-white shadow-soft" aria-hidden="true">
              MA
            </span>
            {site.firstName}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <CalendarDays size={15} aria-hidden="true" class="text-coral-400" />
            {dateFormatter.format(post.data.pubDate)}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Clock size={15} aria-hidden="true" class="text-coral-400" />
            {readingTime} min read
          </span>
        </div>

        <div class="mt-6 flex flex-wrap gap-1.5">
          {
            post.data.tags.map((tag) => (
              <span key={tag} class="rounded-full bg-lavender-100 px-3 py-1 text-xs font-semibold text-violet-600 dark:bg-plum-800 dark:text-lavender-300">
                {tag}
              </span>
            ))
          }
        </div>
      </header>

      <!-- Divider -->
      <div class="reveal my-10 h-px bg-gradient-to-r from-coral-300 via-lavender-300 to-mint-300 opacity-60 dark:from-coral-500/40 dark:via-lavender-400/40 dark:to-mint-400/40" aria-hidden="true" />

      <!-- Body -->
      <div class="prose-blog reveal" style="--reveal-delay: 140ms">
        <Content />
      </div>

      <!-- Post footer -->
      <footer class="reveal mt-14 rounded-4xl border border-lavender-200/70 bg-white/70 p-6 shadow-soft dark:border-plum-800 dark:bg-plum-900/60 sm:p-8">
        <div class="flex flex-col items-center gap-4 text-center">
          <span aria-hidden="true" class="text-3xl">👩‍💻</span>
          <div>
            <p class="font-display text-lg font-bold text-plum dark:text-cream">
              Written by {site.fullName}
            </p>
            <p class="mt-1 text-sm text-plum-soft dark:text-lavender-100/75">
              Senior iOS Engineer building apps I'm proud of — one clean commit at a time.
            </p>
          </div>
          <a
            href={`${import.meta.env.BASE_URL}blogs/`}
            class="inline-flex items-center gap-2 rounded-full bg-coral-500 px-5 py-2.5 text-sm font-bold text-white shadow-soft transition-all duration-200 hover:-translate-y-0.5 hover:bg-coral-600 hover:shadow-glow"
          >
            Back to all posts
          </a>
        </div>

        {
          nextPost && (
            <a
              href={`${import.meta.env.BASE_URL}blogs/${nextPost.id}/`}
              class="group mt-6 block border-t border-lavender-200/70 pt-6 dark:border-plum-800"
            >
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-plum-muted dark:text-lavender-100/50">
                Up next
              </span>
              <span class="mt-1 flex items-center justify-between gap-3">
                <span class="font-display text-lg font-bold text-plum transition-colors group-hover:text-coral-500 dark:text-cream dark:group-hover:text-coral-400">
                  {nextPost.data.title}
                </span>
                <ArrowRight size={18} aria-hidden="true" class="shrink-0 text-coral-400 transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </a>
          )
        }
      </footer>
    </article>
  </main>
  <Footer />
</Layout>
