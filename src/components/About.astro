---
import SectionHeading from './SectionHeading.astro';
import { aboutParagraphs, stats } from '../data/content';
---

<section id="about" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading
      emoji="🌸"
      eyebrow="About Me"
      title="A little about me"
      subtitle="Developer, mentor, and lifelong learner based in Alexandria."
    />

    <div class="mt-14 grid items-start gap-10 lg:grid-cols-[1.15fr_1fr]">
      <!-- Bio copy -->
      <div class="space-y-5">
        <p class="reveal text-lg leading-relaxed text-plum-soft dark:text-lavender-100/85">
          {aboutParagraphs[0]}
        </p>
        <p class="reveal text-lg leading-relaxed text-plum-soft dark:text-lavender-100/85" style="--reveal-delay: 120ms">
          {aboutParagraphs[1]}
        </p>

        <!-- Fun personal touch -->
        <div
          class="reveal mt-6 flex items-start gap-3 rounded-3xl border border-mint-200 bg-mint-50 p-5 dark:border-plum-800 dark:bg-plum-800/40"
          style="--reveal-delay: 200ms"
        >
          <span aria-hidden="true" class="text-2xl">☕</span>
          <p class="text-base font-medium leading-relaxed text-plum dark:text-cream">
            {aboutParagraphs[2]}
          </p>
        </div>
      </div>

      <!-- Photo placeholder + quick facts -->
      <div class="reveal">
        <!-- TODO: Replace this placeholder with Marwa's real portrait. Either
             drop a photo at src/assets/ and import it, or swap the block for
             <img src="/your-photo.jpg" /> inside the card below. -->
        <div
          class="relative grid h-72 place-items-center overflow-hidden rounded-4xl border-2 border-dashed border-lavender-300 bg-gradient-to-br from-blush-100 via-peach-100 to-sunny-100 dark:border-plum-700 dark:from-plum-800 dark:via-plum-900 dark:to-plum-800"
        >
          <span aria-hidden="true" class="text-7xl">👩‍💻</span>
          <span
            class="absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-plum-soft backdrop-blur-sm dark:bg-plum-900/80 dark:text-lavender-100"
          >
            📸 Photo placeholder — swap me for a real portrait!
          </span>
        </div>

        <!-- Quick facts -->
        <ul class="mt-6 space-y-3">
          <li class="flex items-center gap-3 rounded-2xl bg-white/70 px-4 py-3 shadow-soft dark:bg-plum-900/60">
            <span aria-hidden="true" class="text-xl">📍</span>
            <span class="font-medium text-plum dark:text-cream">Alexandria, Egypt</span>
          </li>
          <li class="flex items-center gap-3 rounded-2xl bg-white/70 px-4 py-3 shadow-soft dark:bg-plum-900/60">
            <span aria-hidden="true" class="text-xl">💼</span>
            <span class="font-medium text-plum dark:text-cream">Senior iOS Developer @ Enozom</span>
          </li>
          <li class="flex items-center gap-3 rounded-2xl bg-white/70 px-4 py-3 shadow-soft dark:bg-plum-900/60">
            <span aria-hidden="true" class="text-xl">🎓</span>
            <span class="font-medium text-plum dark:text-cream">ITI & Alexandria University grad</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Stats strip -->
    <div class="mt-14 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        stats.map((stat, i) => (
          <div
            class={`reveal rounded-3xl border border-lavender-200/70 bg-white/70 p-6 text-center shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift dark:border-plum-800 dark:bg-plum-900/60 ${
              i % 2 === 0
                ? 'hover:border-blush-300'
                : 'hover:border-mint-300'
            }`}
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <p class="font-display text-2xl font-bold text-coral-500 dark:text-coral-400 sm:text-3xl">
              {stat.value}
            </p>
            <p class="mt-1 text-sm font-medium text-plum-soft dark:text-lavender-100/70">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
