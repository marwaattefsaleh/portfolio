---
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/content';
---

<section id="skills" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading
      emoji="🛠️"
      eyebrow="Skills"
      title="My toolbox"
      subtitle="The languages, patterns, and tools I reach for every day."
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((group, gi) => (
          <article
            class="reveal group rounded-4xl border border-white/70 bg-white/70 p-6 shadow-soft backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lift dark:border-plum-800 dark:bg-plum-900/60"
            style={`--reveal-delay: ${(gi % 3) * 100}ms`}
          >
            <div class="flex items-center gap-3">
              <span
                aria-hidden="true"
                class="grid h-11 w-11 place-items-center rounded-2xl bg-lavender-100 text-xl transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-110 dark:bg-plum-800"
              >
                {group.emoji}
              </span>
              <h3 class="font-display text-lg font-bold text-plum dark:text-cream">{group.title}</h3>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              {
                group.skills.map((skill) => (
                  <span
                    class={`rounded-full px-3.5 py-1.5 text-sm font-semibold text-plum transition-transform duration-200 hover:scale-105 dark:text-lavender-100 ${group.accent}`}
                  >
                    {skill}
                  </span>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
